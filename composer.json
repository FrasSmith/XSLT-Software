{
    "name": "effortmark/pptx-checker",
    "description": "Standalone PHP PowerPoint accessibility report tool",
    "type": "project",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-xsl": "*",
        "ext-zip": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Effortmark\\PptxChecker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Effortmark\\PptxChecker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        }
    }
}
